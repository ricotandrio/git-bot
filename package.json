{
  "name": "git-bot",
  "version": "0.1.0",
  "description": "",
  "authors": [
    "@ricotandrio"
  ],
  "keywords": [],
  "bugs": {
    "url": "https://github.com/ricotandrio/git-bot/issues"
  },
  "scripts": {
    "dev:bot": "dotenv -e .env -- tsx watch src/main.bot.ts",
    "dev:api": "dotenv -e .env -- tsx watch src/main.api.ts",
    "dev": "npm-run-all --parallel dev:bot dev:api",
    "test": "npm-run-all test:unit test:integration",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "start:bot": "dotenv -e .env -- node dist/main.bot.js",
    "start:api": "dotenv -e .env -- node dist/main.api.js",
    "start": "npm-run-all --parallel start:bot start:api",
    "docker:up": "docker compose --env-file .env up --build",
    "docker:down": "docker compose down",
    "docker:build": "docker build -f Dockerfile.api -t git-bot-api:latest . && docker build -f Dockerfile.bot -t git-bot-bot:latest .",
    "docker:run:bot": "docker run --env-file .env git-bot-bot:latest",
    "docker:run:api": "docker run --env-file .env -p 3000:3000 git-bot-api:latest"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^12.6.2",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "openai": "^6.33.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/pino": "^7.0.4",
    "dotenv-cli": "^11.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
